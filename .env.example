# ============================================================
# BOTTEU — Binance Spot Trading Bot
# Environment Configuration
# ============================================================
# Copy to .env and fill in real values. NEVER commit .env to git!

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-use-python-secrets-token-hex-32

# Database
# +psycopg is required: requirements.txt installs psycopg3 (psycopg2-binary has
# no Python 3.13 wheel). A bare "postgresql://" URL makes SQLAlchemy default to
# the psycopg2 dialect and fail with ModuleNotFoundError at startup.
DATABASE_URL=postgresql+psycopg://botteu_user:strongpassword@localhost:5432/botteu_db

# Redis — SSE pub/sub (live bot logs) + rate-limiter storage
REDIS_URL=redis://localhost:6379/0

# Fernet Master Key (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# Keep this secret — it encrypts all Binance API keys stored in the database.
FERNET_KEY=your-base64-fernet-key-here

# Email (Flask-Mail)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=BOTTEU <noreply@botteu.io>

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/telegram/webhook

# Stripe
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# App URL
APP_URL=http://localhost:5000

# ML Models directory (persistent disk mount in production)
ML_MODELS_DIR=/opt/render/ml_models

# Collector HTTP server Bearer token (leave empty to disable auth locally)
COLLECTOR_API_TOKEN=your-secret-token-here

# This deployment's static outbound IP(s) (comma-separated), shown to users on
# the Guides page and API Key page so they can whitelist it in Binance API
# Management. Set to whatever this host's real outbound IP is — update this
# whenever the app moves to a different host, or Binance API calls will be
# rejected/blocked for users who whitelisted the old IP.
OUTBOUND_IPS=

# In-process Binance collector (streams klines -> CSV in a background thread).
# Leave COLLECTOR_SYMBOLS empty to disable the collector thread entirely.
DATA_DIR=./data
COLLECTOR_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT
COLLECTOR_ROLL_WINDOW=7770
